# Copie para .env.local (fica fora do git). Usado pelos scripts de scripts/banco/,
# principalmente enviar_imagens_s3.py. O front tem o seu: front/.env.example.

# Usuario IAM criado por infra/aws/criar_bucket_s3.sh (so tem permissao no prefixo abaixo).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1

# Bucket e pasta publica dos recortes das questoes.
S3_BUCKET=
S3_PREFIXO=questoes
S3_URL_BASE=https://<bucket>.s3.sa-east-1.amazonaws.com/questoes

# Sal do nome opaco das imagens (HMAC do id da questao). Deixe vazio: o script gera e
# grava aqui na primeira execucao. Nao troque depois do upload, senao os nomes mudam.
S3_SAL=
