      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Consulta de verdade no banco: e isso que o Supabase conta como atividade.\nwith novo as (insert into public.manter_ativo (origem) values ('n8n') returning ping_em),\nvelhos as (delete from public.manter_ativo where ping_em < now() - interval '30 days' returning 1)\nselect (select ping_em from novo) as ping_em,\n       (select count(*) from velhos) as apagados,\n       (select count(*) from public.questoes_enem) as questoes_no_banco;",
        "options": {}
      },
