# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Sem N8N_WEBHOOK_BASE o site roda em MODO DEMONSTRACAO: sorteia do banco local
# (data/banco/) em memoria, sem n8n nem Supabase. Bom para mexer no visual.

# Base dos webhooks de producao do n8n (sem barra no final).
N8N_WEBHOOK_BASE=https://api.data.descomplica.io/webhook

# Mesmo valor da credencial Header Auth "Simulado ENEM · token do front" no n8n
# (header x-simulado-token). Fica so no servidor: nunca use NEXT_PUBLIC_ aqui.
N8N_TOKEN=
